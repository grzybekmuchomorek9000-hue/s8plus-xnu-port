+
+static bool fitsBuffer(const RenderBuffer &buffer, unsigned width, unsigned height, unsigned pitch) {
+	return buffer.memory && pitch % 4 == 0 && pitch >= width * 4 &&
+	       (uint64_t)(height - 1) * pitch + width * 4 <= buffer.size;
+}
+
+/* All addresses passed to the GPU come from this address space. The
+ * caller serializes this with the framebuffer and keeps the buffers
+ * alive if stopped becomes false. */
+static bool composite(RenderAddressSpace &space, const RenderBuffer &front, const RenderBuffer &back,
+    const RenderBuffer &output, unsigned width, unsigned height, unsigned frontPitch,
+    unsigned backPitch, unsigned outputPitch, bool &stopped) {
+	if (!space.tables || !width || !height || width > 4096 || height > 4096 ||
+	    front.owner != &space || back.owner != &space || output.owner != &space ||
+	    front.writable || back.writable || !output.writable ||
+	    !fitsBuffer(front, width, height, frontPitch) ||
+	    !fitsBuffer(back, width, height, backPitch) ||
+	    !fitsBuffer(output, width, height, outputPitch)) return false;
+	const Rectangle rect = {front.gpuAddress(), output.gpuAddress(), frontPitch, outputPitch,
+	    width, height, back.gpuAddress(), backPitch};
+	cleanGpuRange(front.cpuAddress(), front.size);
+	cleanGpuRange(back.cpuAddress(), back.size);
+	cleanGpuRange(output.cpuAddress(), output.size);
+	bool done = run(BlendBuffers, 0, &rect, space.physical, &stopped);
+	if (stopped) invalidateGpuRange(output.cpuAddress(), output.size);
+	return done;
+}
+
+/* Exercise the buffer allocator with separate read-only inputs
+ * and a writable output, spanning multiple independently wired pages. */
+static bool checkRenderBuffers(bool &stopped) {
+	static RenderAddressSpace space;
+	static RenderBuffer front, back, output;
+	if (!space.init()) return false;
+	bool result = false;
+	if (space.allocate(7 * PAGE, false, front) && space.allocate(7 * PAGE, false, back) &&
+	    space.allocate(7 * PAGE, true, output)) {
+		const Rectangle rect = {front.gpuAddress(), output.gpuAddress(), PAGE, PAGE - 16,
+		    blendRect.width, blendRect.height, back.gpuAddress(), PAGE + 16};
+		uint32_t *frontPixels = (uint32_t *)front.cpuAddress();
+		uint32_t *backPixels = (uint32_t *)back.cpuAddress();
+		uint32_t *outputPixels = (uint32_t *)output.cpuAddress();
+		for (unsigned y = 0; y < rect.height; ++y) {
+			for (unsigned x = 0; x < rect.width; ++x) {
+				frontPixels[y * rect.srcStride / 4 + x] = blendInput(false, x, y);
+				backPixels[y * rect.backgroundStride / 4 + x] = blendInput(true, x, y);
+			}
+		}
+		for (unsigned i = 0; i < output.size / 4; ++i) outputPixels[i] = POISON;
+		const bool done = composite(space, front, back, output, rect.width, rect.height,
+		    rect.srcStride, rect.backgroundStride, rect.dstStride, stopped);
+		unsigned bad = 0;
+		if (done) {
+			for (unsigned i = 0; i < output.size / 4; ++i) {
+				unsigned x, y;
+				unsigned expected = rectCoords(rect.dst + i * 4, rect.dst, rect.dstStride, &rect, x, y)
+				    ? blendPixel(x, y) : POISON;
+				if (outputPixels[i] != expected) ++bad;
+			}
+		}
+		if (!stopped) return false; /* Static storage pins every live DMA target. */
+		result = done && !bad;
+	}
+	space.release(output);
+	space.release(back);
+	space.release(front);
+	space.tables->release();
+	space = {};
+	return result;
+}
+
+static void init() {
+	int enabled = 0;
+	if (!PE_parse_boot_argn("s8mali_runtime", &enabled, sizeof(enabled)) || enabled != 1)
+		return;
+	vm_offset_t pmu = ml_io_map(0x16484000, PAGE);
+	if (!pmu || (*(volatile uint32_t *)(pmu + 0xe4) & 15) != 15) {
+		IOLog("S8 MALI: runtime G3D power is off\n");
+		return;
+	}
+	regs = ml_io_map(0x13900000, 0x5000);
+	if (!regs || rd(0) != 0x60a00001 || ((rd(0x14) >> 8) & 255) < 36) {
+		IOLog("S8 MALI: runtime GPU ID/address width mismatch\n");
+		return;
+	}
+	memory = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryPhysicallyContiguous, SIZE, PAGE);
+	if (!memory) { IOLog("S8 MALI: runtime allocation failed\n"); return; }
+	IOByteCount length = 0;
+	physical = memory->getPhysicalSegment(0, &length);
+	bytes = (uintptr_t)memory->getBytesNoCopy();
+	if (!bytes || !physical || (physical & (PAGE - 1)) || (bytes & (PAGE - 1)) ||
+	    length < SIZE || physical + SIZE > (1ULL << 36)) {
+		IOLog("S8 MALI: runtime invalid DMA allocation\n");
+		memory->release(); memory = NULL;
+		return;
+	}
+	IOLog("S8 MALI: runtime v1 XNU-owned DMA=%llx size=%u\n", physical, SIZE);
+	ready = run(Write32, 0);
+	if (ready) ready = run(Clear16, 0xff00ff00);
+	if (ready) ready = run(Copy16, 0);
+	if (ready) ready = run(RectTest, 0, &testRect);
+	if (ready) {
+		bool stopped = true;
+		compositionVerified = run(BlendTest, 0, &blendRect, 0, &stopped);
+		IOLog("S8 MALI: layer composition verified=%u\n", compositionVerified);
+		if (compositionVerified) {
+			compositionVerified = checkRenderBuffers(stopped);
+			IOLog("S8 MALI: separate buffer composition verified=%u\n", compositionVerified);
+		}
+		if (!stopped) ready = false;
+	}
+	IOLog("S8 MALI: runtime offscreen ready=%u\n", ready);
+}
+
+static void tick(uint64_t count) {
+	if (!ready || tests >= 2 || count % 600 != 0) return;
+	++tests;
+	ready = run(Clear16, tests == 1 ? 0xffff0000 : 0xff0000ff);
+	IOLog("S8 MALI: runtime repeat=%u ready=%u\n", tests, ready);
+}
+} /* namespace S8Mali */
