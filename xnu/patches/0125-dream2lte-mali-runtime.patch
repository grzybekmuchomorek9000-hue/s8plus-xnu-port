+			job[0x700 / 4 + 1] = rect->dst;
+			job[0x700 / 4 + 2] = rect->srcStride;
+			job[0x700 / 4 + 3] = rect->dstStride;
+			job[0x700 / 4 + 4] = rect->width;
+			job[0x700 / 4 + 5] = rect->height;
