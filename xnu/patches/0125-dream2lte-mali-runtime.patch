+		volatile uint64_t *l2 = pt + 2 * PAGE / 8;
+		for (unsigned i = 0; i < TABLES_PER_SURFACE; i++) {
+			l2[(PANEL_SRC >> 21) + i] = (leafPhys + i * PAGE) | 3;
+			l2[(PANEL_DST >> 21) + i] = (leafPhys + (TABLES_PER_SURFACE + i) * PAGE) | 3;
+		}
+	}
