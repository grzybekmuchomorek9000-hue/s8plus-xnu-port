+		job[30] = 0x1500;  /* draw.state -> renderer state */
+		job[44] = 0x1600;  /* draw.thread_storage -> local storage */
+		job[0x500 / 4] = 0x1800; /* renderer state shader pointer */
+		job[0x600 / 4 + 1] = 31; /* no workgroup-local memory */
+		if (kind == Copy16) {
