+		volatile uint64_t *l2 = pt + 2 * PAGE / 8;
+		for (unsigned i = 0; i < RenderLeafCount; i++)
+			l2[(RenderBase >> 21) + i] = (leafPhys + i * PAGE) | 3;
+	}
