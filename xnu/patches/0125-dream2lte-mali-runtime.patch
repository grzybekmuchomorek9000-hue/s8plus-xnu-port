+			const uint32_t va = 0x2000 + i * 4;
+			const bool target = va >= rect->dst;
+			const uint32_t base = target ? rect->dst : rect->src;
+			const uint32_t pitch = target ? rect->dstStride : rect->srcStride;
+			if (va >= base) {
