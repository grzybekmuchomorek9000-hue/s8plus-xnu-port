+			 * buffers or reusing their GPU addresses. They fit below 128 MiB. */
+			wr(as + 0x10, 26); wr(as + 0x14, 0);
+			wr(as + 0x18, 2);
+			stopped = wait(as + 0x28, 1, 0);
+			if (stopped) {
