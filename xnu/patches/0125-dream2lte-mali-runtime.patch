+/* SPDX-License-Identifier: GPL-2.0-only
+ * Opt-in Mali-G71 runtime bring-up for dream2lte. Not an IOAccelerator.
+ * Register/LPAE definitions: Linux Panfrost 141b164bbe18.
+ * Fragment descriptors: Mesa genxml v6, e24dc5bd1e7f (MIT).
+ * Included in SweetFramebuffer.cpp; all access is on its one work loop.
+ */
+#if defined(DREAMLTE)
+#include <IOKit/IOBufferMemoryDescriptor.h>
+extern "C" vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+namespace S8Mali {
+static vm_offset_t regs;
+static IOBufferMemoryDescriptor *memory;
+static uintptr_t bytes;
+static uint64_t physical;
+static bool ready;
+static unsigned tests;
+enum { PAGE = 4096, SIZE = 7 * PAGE, COMMAND = 4 * PAGE, OUTPUT = 5 * PAGE };
+static const uint32_t POISON = 0xdeadbeef;
+
+static uint32_t rd(unsigned off) { return *(volatile uint32_t *)(regs + off); }
+static void wr(unsigned off, uint32_t v) {
+	*(volatile uint32_t *)(regs + off) = v;
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+static uint64_t ticks() {
+	uint64_t t;
+	__asm__ volatile("isb; mrs %0, cntpct_el0" : "=r"(t));
+	return t;
+}
+static bool wait(unsigned off, uint32_t mask, uint32_t value) {
+	uint64_t start = ticks();
+	do {
+		if ((rd(off) & mask) == value) return true;
+		/* Use the architectural counter directly. The first XNU IODelay
+		 * trial timed out although readback immediately showed AS idle. */
+		__asm__ volatile("yield" ::: "memory");
+	} while (ticks() - start < 2600000); /* 100 ms at 26 MHz */
+	return (rd(off) & mask) == value; /* Final sample at the deadline. */
+}
+static void dump(unsigned stage) {
+	IOLog("S8 MALI: regs stage=%u id=%x gpu_status=%x gpu_raw=%x gpu_fault=%x\n",
+	    stage, rd(0), rd(0x34), rd(0x20), rd(0x3c));
+	IOLog("S8 MALI: MMU ttbr=%x:%x attr=%x:%x config=%x:%x status=%x fault=%x addr=%x:%x raw=%x\n",
+	    rd(0x2404), rd(0x2400), rd(0x240c), rd(0x2408), rd(0x2434), rd(0x2430),
+	    rd(0x2428), rd(0x241c), rd(0x2424), rd(0x2420), rd(0x2000));
+	IOLog("S8 MALI: power l2=%x shader=%x transition=%x:%x\n",
+	    rd(0x160), rd(0x140), rd(0x220), rd(0x200));
+}
+static void clean() {
+	for (uintptr_t a = bytes; a < bytes + SIZE; a += 64)
+		__asm__ volatile("dc cvac, %0" :: "r"(a) : "memory");
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+static void invalidate() {
+	for (uintptr_t a = bytes; a < bytes + SIZE; a += 64)
+		__asm__ volatile("dc ivac, %0" :: "r"(a) : "memory");
+	__asm__ volatile("dsb sy" ::: "memory");
+}
+
+/* Two GPU pages only: descriptors at 0x1000, target at 0x2000.
+ * The canary page is allocated by XNU but deliberately not GPU-mapped.
+ */
+static void prepare(bool fragment, uint32_t color) {
+	bzero((void *)bytes, SIZE);
+	volatile uint64_t *pt = (volatile uint64_t *)bytes;
+	for (unsigned i = 0; i < 3; i++)
+		pt[i * PAGE / 8] = (physical + (i + 1) * PAGE) | 3;
+	pt[3 * PAGE / 8 + 1] = (physical + COMMAND) | 0x2c1;
+	pt[3 * PAGE / 8 + 2] = (physical + OUTPUT) | 0x2c1;
+	volatile uint32_t *dst = (volatile uint32_t *)(bytes + OUTPUT);
+	for (unsigned i = 0; i < 2 * PAGE / 4; i++) dst[i] = POISON;
+	volatile uint32_t *job = (volatile uint32_t *)(bytes + COMMAND);
+	job[4] = (1u << 16) | ((fragment ? 9u : 2u) << 1) | 1;
+	if (!fragment) {
+		job[8] = 0x2000;
+		job[10] = 3; /* WRITE_VALUE ZERO */
+	} else {
+		/* One 16x16 tile. No geometry and no shader: hardware RT clear. */
+		job[10] = 0x1201; /* framebuffer 0x1200, MFBD flag */
+		volatile uint32_t *fb = job + 0x200 / 4;
+		fb[4] = 0x1400; /* sample positions, 8-bit subpixel units */
+		job[0x400 / 4] = 0x00800080;
+		job[0x480 / 4] = 0x00800080; /* sample-pattern origin */
+		fb[8] = 15 | (15u << 16);
+		fb[10] = 15 | (15u << 16);
+		fb[11] = (2u << 6) | (8u << 9) | (1u << 24);
+		fb[12] = 1u << 16; /* D24. Legacy empty-tile flag faults on this G71. */
+		/* Null tiler pointer is the clear-only (no geometry) path. */
+		volatile uint32_t *rt = job + 0x280 / 4;
+		rt[0] = 1u << 26; /* internal RGBA8 */
+		rt[1] = 1u | (19u << 3) | (2u << 10) | (0x688u << 16) | (1u << 31);
+		rt[8] = 0x2000;
+		rt[10] = 64; /* 16 RGBA8 pixels */
+		for (unsigned i = 12; i < 16; i++) rt[i] = color;
+	}
+	clean();
+}
+
+static bool run(bool fragment, uint32_t color) {
+	/* Refuse shared, busy, faulted or previously configured hardware. */
+	const unsigned slot = fragment ? 0 : 1;
+	const unsigned js = 0x1800 + 0x80 * slot, as = 0x2400;
+	const uint32_t irqMask = 0x10001u << slot;
+	if (rd(0) != 0x60a00001 || !(rd(0x1c) & (1u << slot)) ||
+	    !(rd(0xc0 + slot * 4) & (1u << (fragment ? 9 : 2))) ||
+	    rd(0x1010) || rd(0x1000) || rd(0x2000) ||
+	    rd(as) || rd(as + 4) || rd(as + 0x30) > 1 || rd(as + 0x34) ||
+	    (rd(as + 0x28) & 1) || rd(js + 0x60)) {
+		IOLog("S8 MALI: runtime skipped busy/incompatible kind=%u\n", fragment);
+		return false;
+	}
+	const unsigned asOff[6] = {0, 4, 8, 12, 0x30, 0x34};
+	const unsigned jsOff[5] = {0x40, 0x44, 0x50, 0x54, 0x58};
+	uint32_t asOld[6], jsOld[5];
+	for (unsigned i = 0; i < 6; i++) asOld[i] = rd(as + asOff[i]);
+	for (unsigned i = 0; i < 5; i++) jsOld[i] = rd(js + jsOff[i]);
+	uint32_t l2 = rd(0x120), shader = rd(0x100), on = rd(0x140);
+	if (!l2 || !shader || rd(0x124) || rd(0x104) || rd(0x220) || rd(0x200))
+		return false;
+	uint32_t affinity = on ? on : (shader & (0u - shader));
+	uint32_t addL2 = l2 & ~rd(0x160), addShader = affinity & ~on;
+	unsigned stage = 1;
+	uint32_t irq = 0, fault = 0, status = 0, value = POISON, errors = 0;
+	uint64_t elapsed = 0;
+	bool mapped = false, stopped = true, ok = false;
+	if (addL2) wr(0x1a0, addL2);
+	if (!wait(0x160, l2, l2)) { addShader = 0; goto cleanup; }
+	if (addShader) wr(0x180, addShader);
+	if (!wait(0x140, affinity, affinity)) goto cleanup;
+	prepare(fragment, color);
+	stage = 2;
+	wr(as, (uint32_t)physical | 7);
+	wr(as + 4, (uint32_t)(physical >> 32));
+	wr(as + 8, 0x00888d88);
+	wr(as + 12, 0);
+	wr(as + 0x30, 0);
+	wr(as + 0x34, 0);
+	wr(as + 0x18, 1);
+	mapped = true;
+	if (!wait(as + 0x28, 1, 0)) { dump(stage); stopped = false; goto cleanup; }
+	stage = 3;
+	wr(js + 0x40, 0x1000);
+	wr(js + 0x44, 0);
+	wr(js + 0x50, affinity);
+	wr(js + 0x54, 0);
+	wr(js + 0x58, (8u << 16) | (3u << 12) | (3u << 8));
+	{
+		uint64_t start = ticks();
+		wr(js + 0x60, 1);
+		do {
+			irq = rd(0x1000) & irqMask;
+			fault = rd(0x2000) & 0x10001;
+			if (irq || fault) break;
+			__asm__ volatile("yield" ::: "memory");
+		} while (ticks() - start < 2600000);
+		elapsed = ticks() - start;
+	}
+	irq = rd(0x1000) & irqMask;
+	fault = rd(0x2000) & 0x10001;
+	if (rd(js + 0x60)) wr(js + 0x60, 0);
+	if (rd(js + 0x60)) { stopped = false; goto cleanup; }
+	if (rd(0x1010) & irqMask) {
+		wr(js + 0x20, 3); /* HARD_STOP only this job */
+		if (!wait(0x1010, irqMask, 0)) { stopped = false; goto cleanup; }
+	}
+	invalidate();
+	status = *(volatile uint32_t *)(bytes + COMMAND);
+	value = *(volatile uint32_t *)(bytes + OUTPUT);
+	for (unsigned i = 0; i < 2 * PAGE / 4; i++) {
+		uint32_t expect = i < (fragment ? 256u : 1u) ? (fragment ? color : 0) : POISON;
+		if (((volatile uint32_t *)(bytes + OUTPUT))[i] != expect) errors++;
+	}
+	ok = irq == (1u << slot) && !fault && status == 1 && !errors;
+	if (ok) stage = 4;
+	if (!ok) dump(stage);
+cleanup:
+	/* If termination cannot be confirmed, retain all DMA memory/mappings
+	 * for the life of this boot and never submit another job. No UAF. */
+	if (stopped) {
+		if (irq) wr(0x1004, irq);
+		if (fault) wr(0x2004, fault);
+		for (unsigned i = 0; i < 5; i++) wr(js + jsOff[i], jsOld[i]);
+		if (mapped) {
+			for (unsigned i = 0; i < 6; i++) wr(as + asOff[i], asOld[i]);
+			wr(as + 0x18, 1);
+			stopped = wait(as + 0x28, 1, 0);
+		}
+		if (stopped && addShader) {
+			wr(0x1c0, addShader);
+			stopped = wait(0x140, addShader, 0);
+		}
+		if (stopped && addL2) {
+			wr(0x1e0, addL2);
+			stopped = wait(0x160, addL2, 0);
+		}
+	}
+	IOLog("S8 MALI: runtime %s stage=%u irq=%x mmu=%x status=%x first=%x bad=%u us=%llu cleanup=%u\n",
+	    fragment ? "clear16" : "write", stage, irq, fault, status, value, errors,
+	    elapsed / 26, stopped);
+	return ok && stopped;
+}
+
+static void init() {
+	int enabled = 0;
+	if (!PE_parse_boot_argn("s8mali_runtime", &enabled, sizeof(enabled)) || enabled != 1)
+		return;
+	vm_offset_t pmu = ml_io_map(0x16484000, PAGE);
+	if (!pmu || (*(volatile uint32_t *)(pmu + 0xe4) & 15) != 15) {
+		IOLog("S8 MALI: runtime G3D power is off\n");
+		return;
+	}
+	regs = ml_io_map(0x13900000, 0x5000);
+	if (!regs || rd(0) != 0x60a00001 || ((rd(0x14) >> 8) & 255) < 36) {
+		IOLog("S8 MALI: runtime GPU ID/address width mismatch\n");
+		return;
+	}
+	memory = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryPhysicallyContiguous, SIZE, PAGE);
+	if (!memory) { IOLog("S8 MALI: runtime allocation failed\n"); return; }
+	IOByteCount length = 0;
+	physical = memory->getPhysicalSegment(0, &length);
+	bytes = (uintptr_t)memory->getBytesNoCopy();
+	if (!bytes || !physical || (physical & (PAGE - 1)) || (bytes & (PAGE - 1)) ||
+	    length < SIZE || physical + SIZE > (1ULL << 36)) {
+		IOLog("S8 MALI: runtime invalid DMA allocation\n");
+		memory->release(); memory = NULL;
+		return;
+	}
+	IOLog("S8 MALI: runtime v1 XNU-owned DMA=%llx size=%u\n", physical, SIZE);
+	ready = run(false, 0);
+	if (ready) ready = run(true, 0xff00ff00);
+	IOLog("S8 MALI: runtime offscreen ready=%u; UI remains CPU-rendered\n", ready);
+}
+
+static void tick(uint64_t count) {
+	if (!ready || tests >= 2 || count % 600 != 0) return;
+	++tests;
+	ready = run(true, tests == 1 ? 0xffff0000 : 0xff0000ff);
+	IOLog("S8 MALI: runtime repeat=%u ready=%u\n", tests, ready);
+}
+} /* namespace S8Mali */
+#endif
